{
  "manifest_version": 3,
  "name": "Second Brain Clipper",
  "version": "1.0.0",
  "description": "Save pages directly to your Second Brain",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "https://*.yourdomain.com/*"
  ]
}
