# Port for the FastAPI microservice (default: 8000)
PORT=8000

# Groq API configuration
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Backend internal URL for embeddings/callbacks
BACKEND_INTERNAL_URL=http://localhost:5001

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend.vercel.app

# Additional comma-separated allowed CORS origins (optional)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com

# Jina API key for live web scraping (optional)
JINA_API_KEY=your-jina-api-key

# Optional OpenAI fallback
# OPENAI_API_KEY=your-openai-api-key
