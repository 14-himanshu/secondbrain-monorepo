{
  "name": "brainly",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf dist && rm -rf ../packages/contracts/dist",
    "build": "npm run clean && npm --prefix ../packages/contracts run build && node --max-old-space-size=1024 ./node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsc && (tsc -w & node --watch dist/index.js)",
    "dev:worker": "tsc && (tsc -w & node --watch dist/worker.js)",
    "test": "node --test dist/__tests__/**/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@secondbrain/contracts": "file:../packages/contracts",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "env": "^0.0.2",
    "express": "^5.1.0",
    "groq-sdk": "^1.1.2",
    "ioredis": "^5.8.2",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "node-cron": "^4.2.1",
    "openai": "^6.35.0",
    "pdf-parse": "^2.4.5",
    "razorpay": "^2.9.6",
    "typescript": "^5.9.3",
    "url-metadata": "^5.4.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.10.0",
    "@types/node-cron": "^3.0.11"
  }
}
